{"dct_title_s":"Street Centerlines, Cambridge, Massachusetts, 2014","dct_description_sm":["Abstract: This line layer contains centerlines of all paved and unpaved roads, ramps, and bridges in the City of Cambridge. Each centerline segment contains attributes including street name, street type, address ranges, and one-way designations.","Purpose: This layer was created for addressing, routing applications, base maps, and general mapping purposes, both for internal and external use."],"dct_creator_sm":["Cambridge (Mass.). Geographic Information Systems"],"dct_publisher_sm":["Cambridge (Mass.). Geographic Information Systems"],"schema_provider_s":"Harvard","gbl_resourceClass_sm":["Datasets"],"gbl_resourceType_sm":["Line data"],"dct_subject_sm":["Roads","Streets","City of Cambridge","Street Centerlines","Road centerlines"],"dcat_theme_sm":["Transportation"],"dct_temporal_sm":["2014"],"dct_issued_s":"2014","gbl_indexYear_im":[2014],"dct_spatial_sm":["Massachusetts","Cambridge"],"locn_geometry":"ENVELOPE(-71.161489,-71.06817,42.40471,42.351476)","dcat_bbox":"ENVELOPE(-71.161489,-71.06817,42.40471,42.351476)","dct_rights_sm":["Use constraints: None","Access constraints: Unrestricted Access Online","Data credit: City of Cambridge"],"dct_accessRights_s":"Public","dct_format_s":"Shapefile","dct_references_s":"{\"http://www.opengis.net/cat/csw/csdgm\":\"https://raw.githubusercontent.com/harvard-library/harvard-geodata/main/fgdc/CAMBRIDGE14CENTERLINES.xml\",\"http://schema.org/downloadUrl\":\"https://mps.lib.harvard.edu/assets/file/hgl:CAMBRIDGE14CENTERLINES\",\"https://github.com/protomaps/PMTiles\":\"https://hgl.harvard.edu/data/public/CAMBRIDGE14CENTERLINES.pmtiles\"}","id":"harvard-cambridge14centerlines","gbl_mdModified_dt":"2014-07-01T00:00:00Z","gbl_mdVersion_s":"Aardvark","dct_language_sm":["eng"],"dct_identifier_sm":["https://hgl.harvard.edu/catalog/harvard-cambridge14centerlines","CAMBRIDGE14CENTERLINES","https://id.lib.harvard.edu/alma/990142665020203941/catalog"],"g